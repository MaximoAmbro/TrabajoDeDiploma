@startuml dominio-actualizado-1-cuentas-catalogo
!include _estilo.iuml
skinparam nodesep 25
skinparam ranksep 45
hide empty members
' Modelo de dominio actualizado, vista 1 de 3: cuentas y catálogo. Los mismos conceptos del
' dominio conceptual, con sus atributos y tipos. Sin identificadores ni claves foráneas: las
' asociaciones las representan. El atributo «/» es derivado (se calcula, no se guarda).
' Las enumeraciones están en la vista 3.

class Usuario {
  nombre : string
  apellido : string
  mail : string
  contraseña : string
  intentosFallidos : int
  bloqueadoHasta : DateTime?
  correoVerificado : bool
}
class Cliente {
  nivel : NivelFidelidad
  fechaUltimaEvaluacion : DateTime?
  /comprasUltimos12Meses : int
}
class Organizador {
  primerEventoAprobado : bool
}
class Administrador
class Suscripción {
  plan : string
  fechaInicio : DateTime
  fechaFin : DateTime
  precio : decimal
  activa : bool
}
class Local {
  nombre : string
  direccion : string
  capacidad : int
}
class Evento {
  nombre : string
  fecha : DateTime
  categoria : string
  estado : EstadoEvento
  finPreventa : DateTime?
  imagenPortada : byte[]
  motivoRechazo : string
}
class Sector {
  nombre : string
  precio : decimal
  capacidad : int
  cantidadReservada : int
}
class "Servicio complementario" as Servicio {
  nombre : string
  tipo : string
  precio : decimal
  activo : bool
}
class "Inscripción en lista de espera" as Inscripcion {
  fechaAlta : DateTime
  conSuscripcion : bool
}

Usuario <|-- Cliente
Usuario <|-- Organizador
Usuario <|-- Administrador
Organizador "1" -- "0..*$_" Local : administra
Local "1" -- "0..*$_" Evento : se realiza en
Evento "1" -- "0..*$_" Sector : se divide en
Evento "0..*" -- "0..*$_" Servicio : ofrece
Cliente "1" -- "0..*$_" Suscripción : contrata
Cliente "1" -- "0..*$_" Inscripcion : se anota en
Inscripcion "0..*" -- "1$_" Evento : es para
@enduml
