<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0, igual que Repo: un proyecto netstandard no puede referenciar uno net472. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Datos</RootNamespace>
    <AssemblyName>Datos</AssemblyName>
    <!-- SqlClient 6.x no publica binarios netstandard2.0; NuGet usa los de net462, que son los
         que efectivamente corren porque Visual.exe es .NET Framework 4.8. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Entidade\Entidades.csproj" />
  </ItemGroup>

</Project>
