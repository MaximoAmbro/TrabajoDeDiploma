@startuml er-1-usuarios-catalogo
!include _estilo.iuml
skinparam nodesep 22
skinparam ranksep 40
' DER, vista 1 de 3: usuarios con sus tres perfiles y catálogo (locales, eventos, sectores y
' servicios). Fuente: BaseDatos/01-esquema.sql, más 11 (CHECK del perfil) y 16 (FK del dueño del
' local, que apunta a Usuario: la base garantiza que exista y el negocio, que sea Organizador). Convención:
' * = NOT NULL; PK, FK, UQ y CK al final.
' La tabla Propietario conserva su nombre: desde el script 11 es la de los organizadores.

entity Usuario {
  * ID : INT <<PK>>
  --
  Nombre : VARCHAR(100)
  Apellido : VARCHAR(100)
  Mail : VARCHAR(150) <<UQ>>
  Contraseña : VARCHAR(100)
  TipoUsuario : VARCHAR(20) <<CK>>
  * Nivel : VARCHAR(8)
  FechaUltimaEvaluacion : DATE
  * IntentosFallidos : INT
  BloqueadoHasta : DATETIME
  * CorreoVerificado : BIT
}
entity Cliente {
  * ID : INT <<PK, FK>>
}
entity "Propietario\n(Organizador)" as Propietario {
  * ID : INT <<PK, FK>>
  --
  * PrimerEventoAprobado : BIT
}
entity Administrador {
  * ID : INT <<PK, FK>>
}
entity Locales {
  * ID : INT <<PK>>
  --
  Nombre : VARCHAR(100)
  Direccion : VARCHAR(100)
  * Capacidad : INT <<CK>>
  * PropietarioID : INT <<FK>>
}
entity Eventos {
  * ID : INT <<PK>>
  --
  Nombre : VARCHAR(100)
  Fecha : DATETIME
  * LocalID : INT <<FK>>
  Categoria : VARCHAR(20)
  * Estado : VARCHAR(12) <<CK>>
  FinPreventa : DATETIME
  ImagenPortada : VARBINARY(MAX)
  MotivoRechazo : NVARCHAR(500)
}
entity Sectores {
  * ID : INT <<PK>>
  --
  * EventoID : INT <<FK>>
  Nombre : VARCHAR(50)
  Precio : DECIMAL(12,2)
  Capacidad : INT
  * CantidadReservada : INT
  CupoLiberadoEl : DATETIME
}
entity Servicios {
  * ID : INT <<PK>>
  --
  * Nombre : VARCHAR(60)
  * Tipo : VARCHAR(20)
  * Precio : DECIMAL(12,2)
  * Activo : BIT
}
entity ServiciosEvento {
  * ID_Evento : INT <<PK, FK>>
  * ID_Servicio : INT <<PK, FK>>
}

Usuario "1$_" ||--o| "0..1$_" Cliente
Usuario "1$_" ||--o| "0..1$_" Propietario
Usuario "1$_" ||--o| "0..1$_" Administrador
Usuario "1$_" ||---o{ "0..*$_" Locales
Propietario -[hidden]- Locales
Locales "1$_" ||--o{ "0..*$_" Eventos
Eventos "1$_" ||--o{ "0..*$_" Sectores
Eventos "1$_" ||--o{ "0..*$_" ServiciosEvento
Servicios "1$_" ||--o{ "0..*$_" ServiciosEvento
@enduml
