@startuml casos-uso-administrador
!include _estilo.iuml
left to right direction
skinparam nodesep 12
skinparam ranksep 25
' Casos de uso del Administrador (perfil «Propietario» en la base, RN-05). Cada caso de uso
' corresponde a una pantalla real y a una operación de negocio (ver la tabla de justificación).

actor Administrador

rectangle "EventAura" {
  usecase "Iniciar sesión" as Iniciar
  usecase "Cambiar contraseña" as Cambiar
  usecase "Registrar local" as RegistrarLocal
  usecase "Consultar\nmis locales" as Locales
  usecase "Gestionar eventos" as Eventos
  usecase "Gestionar sectores" as Sectores
  usecase "Consultar listas\nde espera" as Listas
  usecase "Controlar ingreso" as Ingreso
  usecase "Generar reportes" as Reportes
  usecase "Exportar reporte\na PDF" as Exportar
}

Administrador --> Iniciar
Administrador --> Cambiar
Administrador --> RegistrarLocal
Administrador --> Locales
Administrador --> Eventos
Administrador --> Listas
Administrador --> Ingreso
Administrador --> Reportes
Sectores ..> Eventos : <<extend>>\n[agrega o quita\nun sector]
Exportar ..> Reportes : <<extend>>\n[pide exportar]
@enduml
