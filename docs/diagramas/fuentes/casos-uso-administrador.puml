@startuml casos-uso-administrador
!include _estilo.iuml
left to right direction
skinparam nodesep 12
skinparam ranksep 25
' Casos de uso del Administrador de la plataforma (RN-05, RN-34). No es dueño de locales: no
' gestiona eventos ni controla ingresos. Los de la cuenta están en casos-uso-cuenta. Cada caso de
' uso corresponde a una pantalla real y a una operación de negocio (ver la tabla de justificación).

actor Administrador

rectangle "EventAura" {
  usecase "Revisar solicitudes\nde Organizador" as Solicitudes
  usecase "Revisar el primer\nevento de un\nOrganizador" as Revision
  usecase "Consultar el registro\nde auditoría" as Auditoria
  usecase "Crear administrador" as Crear
  usecase "Generar reportes" as Reportes
  usecase "Exportar reporte\na PDF" as Exportar
}

Administrador --> Solicitudes
Administrador --> Revision
Administrador --> Auditoria
Administrador --> Crear
Administrador --> Reportes
Exportar ..> Reportes : <<extend>>\n[pide exportar]
@enduml
