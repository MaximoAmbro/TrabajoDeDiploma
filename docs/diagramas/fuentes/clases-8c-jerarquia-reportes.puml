@startuml clases-8c-jerarquia-reportes
!include _estilo.iuml
left to right direction
skinparam nodesep 10
skinparam ranksep 60
hide empty members
' Diagrama de clases, vista 8c: jerarquía de Reporte (anexo A02). Fuente: Repo/Reporte*.cs y
' Repo/GestorReportes.cs. Cada subclase redefine Encabezados, Obtener y Lectura, y declara
' su código RPT-0x. GestorReportes.Nuevo elige la subclase según el código.

abstract class Reporte {
  + Codigo : string
  + Titulo : string
  + Desde : DateTime
  + Hasta : DateTime
  + Solicitante : string
  + NombreArchivo : string
  + {abstract} Encabezados() : string[]
  + {abstract} Obtener(RepositorioReportes) : DataTable
  + {abstract} Lectura(DataTable) : string
  + Filtros() : string
}
class ReporteVentasPorEvento <<RPT-01>>
class ReporteRankingPaquetes <<RPT-02>>
class ReporteUsuariosPorNivel <<RPT-03>>
class ReporteAdopcionBeneficios <<RPT-04>>
class ReporteDemandaInsatisfecha <<RPT-05>>

Reporte <|-- ReporteVentasPorEvento
Reporte <|-- ReporteRankingPaquetes
Reporte <|-- ReporteUsuariosPorNivel
Reporte <|-- ReporteAdopcionBeneficios
Reporte <|-- ReporteDemandaInsatisfecha
@enduml
