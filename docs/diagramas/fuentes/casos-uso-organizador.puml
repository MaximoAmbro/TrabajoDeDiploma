@startuml casos-uso-organizador
!include _estilo.iuml
left to right direction
skinparam nodesep 12
skinparam ranksep 25
' Casos de uso del Organizador (RN-05, RN-48): opera solo sobre sus propios locales (RN-49).
' Los de la cuenta están en casos-uso-cuenta. Cada caso de uso corresponde a una pantalla real
' y a una operación de negocio (ver la tabla de justificación).

actor Organizador

rectangle "EventAura" {
  usecase "Registrar local" as RegistrarLocal
  usecase "Consultar\nmis locales" as Locales
  usecase "Gestionar eventos" as Eventos
  usecase "Gestionar sectores" as Sectores
  usecase "Publicar evento" as Publicar
  usecase "Consultar listas\nde espera" as Listas
  usecase "Controlar ingreso" as Ingreso
  usecase "Generar reportes" as Reportes
  usecase "Exportar reporte\na PDF" as Exportar
}

Organizador --> RegistrarLocal
Organizador --> Locales
Organizador --> Eventos
Organizador --> Publicar
Organizador --> Listas
Organizador --> Ingreso
Organizador --> Reportes
Sectores ..> Eventos : <<extend>>\n[agrega o quita\nun sector]
Exportar ..> Reportes : <<extend>>\n[pide exportar]
@enduml
