@startuml casos-uso-cliente
!include _estilo.iuml
left to right direction
skinparam nodesep 12
skinparam ranksep 25
' Casos de uso del cliente. Cada caso de uso corresponde a una pantalla real y a una operación
' de negocio (ver la tabla de justificación). El pago lo resuelve una pasarela simulada dentro
' del sistema, por eso no es un actor.

actor Visitante
actor Cliente

rectangle "EventAura" {
  usecase "Registrarse" as Registrarse
  usecase "Iniciar sesión" as Iniciar
  usecase "Cambiar\ncontraseña" as Cambiar
  usecase "Buscar eventos" as Buscar
  usecase "Comprar paquete" as Comprar
  usecase "Aplicar\ndescuento\npor nivel" as Descuento
  usecase "Pagar\nla compra" as Pagar
  usecase "Contratar\nseguro" as Seguro
  usecase "Inscribirse en\nlista de espera" as Inscribirse
  usecase "Ver historial\nde compras" as Historial
  usecase "Devolver\nentrada" as Devolver
  usecase "Gestionar\nsuscripción" as Suscripcion
}

Visitante --> Registrarse
Cliente --> Iniciar
Cliente --> Cambiar
Cliente --> Buscar
Cliente --> Comprar
Cliente --> Historial
Cliente --> Suscripcion
Comprar ..> Descuento : <<include>>
Comprar ..> Pagar : <<include>>
Seguro ..> Comprar : <<extend>>\n[lo elige]
Inscribirse ..> Comprar : <<extend>>\n[agotado]
Devolver ..> Historial : <<extend>>\n[con seguro,\n> 48 h antes]
@enduml
